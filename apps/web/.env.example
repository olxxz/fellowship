# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# ── Supabase (Project Settings → API Keys). Sem elas, o app roda só o protótipo.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (sb_publishable_…). Também aceita o nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── LiveKit (Settings → Keys no LiveKit Cloud).

# Endereço do servidor (vai para o navegador; não é segredo).
NEXT_PUBLIC_LIVEKIT_URL=wss://seu-projeto.livekit.cloud

# Só no servidor. Nunca use o prefixo NEXT_PUBLIC_ nestas duas.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
