{
  "name": "@fellowship/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.sass",
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  }
}
